# Copy this file to .env and replace the value with a unique random secret.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
PORT=3000
NODE_ENV=development
# In production, serve the app only behind a correctly configured HTTPS proxy:
# NODE_ENV=production
# HTTPS_ENABLED=true
